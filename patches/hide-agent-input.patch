+/// Rows kept below the pane once an agent's input box is hidden. A box this
+/// tall or smaller takes no rows from what's shown over it.
+const HIDDEN_ROWS: u16 = 6;
+
+/// Where a known agent's input box starts on this screen.
+fn hidden_input_row(rows: &[Rc<Vec<vt::Cell>>]) -> Option<u16> {
+    let first = rows.len().saturating_sub(crate::agent_input::SEARCHED_ROWS);
+    // A cell the program skipped over instead of writing a space to has no text.
+    let text: Vec<String> = rows[first..].iter().map(|row| row.iter().map(|c| if c.text.is_empty() { " " } else { c.text.as_str() }).collect()).collect();
+    crate::agent_input::find(&text).map(|y| (first + y) as u16)
 }
 
