@@ -0,0 +1,144 @@
+//! Finds the input box a coding agent draws at the bottom of its screen, for
+//! layouts whose own message box replaces it (`message_box`).
+//!
+//! Only an exact match hides anything. A permission dialog, a picker, or a
+//! program this doesn't know matches nothing and stays fully on screen, so
+//! something the person must answer can't end up hidden.
+
+/// How far up from the last line with text a box's footer may be.
+const FOOTER_ROWS: usize = 4;
+/// How many rows a box may take, wrapped input included.
+const BOX_ROWS: usize = 16;
+/// The rows searched, counted up from the screen's bottom.
+pub const SEARCHED_ROWS: usize = FOOTER_ROWS + BOX_ROWS + 12;
+
+/// The first row of the agent's input box in `rows` (a screen's text, top to
+/// bottom), or None when no known box is there.
+pub fn find(rows: &[String]) -> Option<usize> {
+    let last = rows.iter().rposition(|r| !r.trim().is_empty())?;
+    claude(rows, last).or_else(|| codex(rows, last)).or_else(|| grok(rows, last))
+}
+
+/// A full-width rule, the `❯` prompt, more input, and a closing rule, with
+/// Claude Code's mode line under it.
+fn claude(rows: &[String], last: usize) -> Option<usize> {
+    let close = (last.saturating_sub(FOOTER_ROWS)..=last).rev().find(|&y| is_rule(&rows[y]))?;
+    (close.saturating_sub(BOX_ROWS)..close)
+        .rev()
+        .find(|&y| y + 1 < close && is_rule(&rows[y]) && rows[y + 1].trim_start().starts_with('❯'))
+}
+
+/// Codex's `›` prompt over its status lines. Its pickers use `›` as well, with
+/// a footer of their own, so the footer is what tells them apart: narrow panes
+/// cut its words short and warnings share its line, so it's matched loosely.
+/// The blank line over the prompt is the box's padding.
+fn codex(rows: &[String], last: usize) -> Option<usize> {
+    let footer = &rows[last.saturating_sub(1)..=last];
+    if !footer.iter().any(|r| r.contains("· Context ") || r.contains("? for shortc")) {
+        return None;
+    }
+    let prompt = (last.saturating_sub(BOX_ROWS)..last).rev().find(|&y| rows[y].trim_start().starts_with('›'))?;
+    Some(if prompt > 0 && rows[prompt - 1].trim().is_empty() { prompt - 1 } else { prompt })
+}
+
+/// Grok's rounded box with `❯` inside. Under it comes its lower border, carrying
+/// the model as `Grok 4.7 (high)`, or in a short pane only its key hints.
+fn grok(rows: &[String], last: usize) -> Option<usize> {
+    let open = (last.saturating_sub(FOOTER_ROWS + BOX_ROWS)..=last).rev().find(|&y| rows[y].trim_start().starts_with('╭'))?;
+    if !rows.get(open + 1)?.trim_start().starts_with("│ ❯") {
+        return None;
+    }
+    rows[open + 2..=last]
+        .iter()
+        .any(|r| (r.trim_start().starts_with('╰') && r.contains('(') && r.contains(')')) || r.contains("Ctrl+x:shortcuts"))
+        .then_some(open)
+}
+
+fn is_rule(row: &str) -> bool {
+    let row = row.trim();
+    row.chars().count() >= 20 && row.chars().all(|c| c == '─')
+}
+
+#[cfg(test)]
+mod tests {
+    use super::find;
+
+    fn screen(text: &str) -> Vec<String> {
+        text.lines().map(str::to_owned).collect()
+    }
+
+    fn rule() -> String {
+        "─".repeat(60)
+    }
+
+    #[test]
+    fn claude_box_starts_at_its_upper_rule() {
+        let rows = screen(&format!("● done\n\n{r}\n❯ \n{r}\n  ⏵⏵ auto mode on (shift+tab to cycle)\n\n", r = rule()));
+        assert_eq!(find(&rows), Some(2));
+    }
+
+    #[test]
+    fn claude_box_keeps_wrapped_input_inside() {
+        let rows = screen(&format!("● done\n{r}\n❯ first line\n  second line\n{r}\n  footer", r = rule()));
+        assert_eq!(find(&rows), Some(1));
+    }
+
+    #[test]
+    fn claude_dialogs_and_pickers_stay_visible() {
+        let permission = format!("● Bash(rm x)\n{r}\n Do you want to proceed?\n ❯ 1. Yes\n   2. No\n{r}", r = rule());
+        assert_eq!(find(&screen(&permission)), None);
+        let picker = "▔▔▔▔▔▔▔▔\n Select model\n ❯ 5. Haiku 5.5 ✔\n Enter to set as default · s to use this session only · Esc to cancel";
+        assert_eq!(find(&screen(picker)), None);
+    }
+
+    #[test]
+    fn codex_box_starts_at_the_padding_over_its_prompt() {
+        let rows = screen("• answer\n\n› Ask Codex to do anything\n\n  GPT-6.1 Terra high · Context 100% left\n  ← for agents · ? for shortcuts\n");
+        assert_eq!(find(&rows), Some(1));
+    }
+
+    #[test]
+    fn codex_box_is_found_when_a_narrow_pane_cuts_its_footer_short() {
+        let rows = screen("• answer\n\n› Ask Codex to do anything\n\n  GPT-6.1 Terra high · Context 100% left · 0 in · 0 out …\n  ← for agents · ? for shortc  ⚠ 4 warnings · f2 to view");
+        assert_eq!(find(&rows), Some(1));
+    }
+
+    #[test]
+    fn codex_picker_stays_visible() {
+        let rows = screen("  Select Model and Effort\n› 3. GPT-6.1 Terra (current)\n  4. GPT-6-Sol\n  enter select · esc back");
+        assert_eq!(find(&rows), None);
+    }
+
+    #[test]
+    fn grok_box_starts_at_its_top_border_and_a_picker_above_it_stays() {
+        let rows = screen("  ❯ Grok 4.7 (current)\n  Grok 4.6\n  ╭──────╮\n  │ ❯    │\n  ╰── Grok 4.7 (high) · always-approve ─╯\n  Shift+Tab:mode  │  Ctrl+x:shortcuts");
+        assert_eq!(find(&rows), Some(2));
+    }
+
+    #[test]
+    fn grok_box_is_found_whatever_sits_under_it() {
+        let rows = screen("  Read Terms and Privacy Policy.\n\n  ╭──────╮\n  │ ❯    │\n  ╰── Grok 4.5 (high) · always-approve ─╯\n\n     Grok Build  1.0.70 [stable]");
+        assert_eq!(find(&rows), Some(2));
+    }
+
+    #[test]
+    fn grok_box_is_found_when_a_short_pane_drops_its_lower_border() {
+        let rows = screen(" Read Terms and Privacy Policy.\n ╭──────╮\n │ ❯    │\n Ctrl+x:shortcuts");
+        assert_eq!(find(&rows), Some(1));
+    }
+
+    #[test]
+    fn a_box_grok_is_only_starting_to_draw_stays_visible() {
+        assert_eq!(find(&screen(" ╭──────╮\n │ ❯    │")), None);
+        assert_eq!(find(&screen(" ╭──────╮")), None);
+    }
+
+    #[test]
+    fn other_programs_keep_every_row() {
+        assert_eq!(find(&screen("PS D:\\Herdr> dir\n❯ git status\n")), None);
+        // A table an agent printed has box drawing, not its prompt.
+        assert_eq!(find(&screen("╭────╮\n│ a  │\n╰────╯\nnext line")), None);
+        assert_eq!(find(&screen(&format!("{r}\nheading\n{r}", r = rule()))), None);
+        assert_eq!(find(&[]), None);
+    }
+}
